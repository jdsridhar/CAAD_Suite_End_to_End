# Normalize line endings: the repo is edited from both Windows tools and WSL.
# CRLF in inputs has already bitten the legacy MD suite (.mdp parsing, ARCHITECTURE_AUDIT §6).
* text=auto eol=lf

*.png binary
*.pdf binary
*.zip binary
*.gz binary
# Preserve downloaded RCSB mmCIF source bytes and ignore archive trailing padding spaces.
benchmarks/redocking/pilot_v1/structures/*.cif -text -whitespace
# Preserve fixed-column docking outputs and raw engine logs byte-for-byte.
*.pdbqt -text -whitespace
*.log -text -whitespace
*.pdb -text -whitespace
*.sdf -text -whitespace
# Preserve generated upstream license/notice text byte content, including intentional trailing spaces.
docs/release/licenses/WEB_BUNDLE_THIRD_PARTY_NOTICES.txt -whitespace
