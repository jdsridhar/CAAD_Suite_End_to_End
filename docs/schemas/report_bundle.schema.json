{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Reference to a content-addressed artifact plus the role it plays for this result.",
      "properties": {
        "artifact_id": {
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "artifact_id",
        "role"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ReportArtifact": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "format": {
          "enum": [
            "html",
            "pdf",
            "json",
            "csv",
            "png",
            "svg"
          ],
          "title": "Format",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "format",
        "media_type",
        "artifact"
      ],
      "title": "ReportArtifact",
      "type": "object"
    }
  },
  "$id": "caddsuite://schemas/report_bundle/1.0",
  "additionalProperties": false,
  "description": "A report result points to files in artifact storage; file bytes stay out of SQLite.",
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ReportArtifact"
      },
      "minItems": 1,
      "title": "Artifacts",
      "type": "array"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "id": {
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Id",
      "type": "string"
    },
    "limitations": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "project_id": {
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "default": "report_bundle/1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "id",
    "project_id",
    "generated_at",
    "artifacts"
  ],
  "title": "ReportBundle",
  "type": "object"
}
