{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Reference to a content-addressed artifact plus the role it plays for this result.",
      "properties": {
        "artifact_id": {
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "artifact_id",
        "role"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ForceFieldFamily": {
      "enum": [
        "charmm",
        "amber",
        "openff"
      ],
      "title": "ForceFieldFamily",
      "type": "string"
    },
    "JsonValue": {},
    "LicenseClass": {
      "description": "License class of an engine or dependency (ADR-0013).",
      "enum": [
        "open_source_permissive",
        "open_source_weak_copyleft",
        "open_source_copyleft",
        "academic_noncommercial",
        "commercial",
        "web_service",
        "unknown"
      ],
      "title": "LicenseClass",
      "type": "string"
    },
    "SoftwareKind": {
      "description": "Role a piece of software plays in a provenance record.",
      "enum": [
        "engine",
        "adapter",
        "library",
        "platform",
        "service",
        "manual_step"
      ],
      "title": "SoftwareKind",
      "type": "string"
    },
    "SoftwareRef": {
      "additionalProperties": false,
      "description": "A piece of software that took part in producing a result (a provenance *agent*).",
      "properties": {
        "environment_id": {
          "anyOf": [
            {
              "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Environment Id"
        },
        "kind": {
          "$ref": "#/$defs/SoftwareKind"
        },
        "license_class": {
          "$ref": "#/$defs/LicenseClass",
          "default": "unknown"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "kind"
      ],
      "title": "SoftwareRef",
      "type": "object"
    }
  },
  "$id": "caddsuite://schemas/parameterization/1.0",
  "additionalProperties": false,
  "description": "Which force field, ligand parameters, charges, water and ions: never implicit.",
  "properties": {
    "artifacts": {
      "additionalProperties": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Artifacts",
      "type": "object"
    },
    "ff_family": {
      "$ref": "#/$defs/ForceFieldFamily"
    },
    "id": {
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Id",
      "type": "string"
    },
    "ion_parameters": {
      "minLength": 1,
      "title": "Ion Parameters",
      "type": "string"
    },
    "ligand_charge_model": {
      "minLength": 1,
      "title": "Ligand Charge Model",
      "type": "string"
    },
    "ligand_method": {
      "minLength": 1,
      "title": "Ligand Method",
      "type": "string"
    },
    "protein_ff": {
      "minLength": 1,
      "title": "Protein Ff",
      "type": "string"
    },
    "quality": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Quality",
      "type": "object"
    },
    "schema_version": {
      "default": "parameterization/1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "tool": {
      "$ref": "#/$defs/SoftwareRef"
    },
    "water_model": {
      "minLength": 1,
      "title": "Water Model",
      "type": "string"
    }
  },
  "required": [
    "id",
    "ff_family",
    "protein_ff",
    "ligand_method",
    "ligand_charge_model",
    "water_model",
    "ion_parameters",
    "tool"
  ],
  "title": "Parameterization",
  "type": "object"
}
