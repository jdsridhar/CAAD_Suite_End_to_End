{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Reference to a content-addressed artifact plus the role it plays for this result.",
      "properties": {
        "artifact_id": {
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "artifact_id",
        "role"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CloseHeavyAtomContact": {
      "additionalProperties": false,
      "description": "A pair of non-directly-bonded heavy atoms inside a screening distance.",
      "properties": {
        "atom_name_a": {
          "minLength": 1,
          "title": "Atom Name A",
          "type": "string"
        },
        "atom_name_b": {
          "minLength": 1,
          "title": "Atom Name B",
          "type": "string"
        },
        "chain_a": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chain A"
        },
        "chain_b": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chain B"
        },
        "distance_A": {
          "exclusiveMinimum": 0,
          "title": "Distance A",
          "type": "number"
        },
        "residue_id_a": {
          "minLength": 1,
          "title": "Residue Id A",
          "type": "string"
        },
        "residue_id_b": {
          "minLength": 1,
          "title": "Residue Id B",
          "type": "string"
        },
        "residue_name_a": {
          "minLength": 1,
          "title": "Residue Name A",
          "type": "string"
        },
        "residue_name_b": {
          "minLength": 1,
          "title": "Residue Name B",
          "type": "string"
        }
      },
      "required": [
        "residue_id_a",
        "residue_name_a",
        "atom_name_a",
        "residue_id_b",
        "residue_name_b",
        "atom_name_b",
        "distance_A"
      ],
      "title": "CloseHeavyAtomContact",
      "type": "object"
    },
    "ComponentRecord": {
      "additionalProperties": false,
      "description": "A non-polymer component found in a structure (and what happened to it).",
      "properties": {
        "category": {
          "enum": [
            "water",
            "ion",
            "metal",
            "cofactor",
            "ligand",
            "additive",
            "modified_residue",
            "other"
          ],
          "title": "Category",
          "type": "string"
        },
        "chain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chain"
        },
        "n_atoms": {
          "minimum": 0,
          "title": "N Atoms",
          "type": "integer"
        },
        "resname": {
          "minLength": 1,
          "title": "Resname",
          "type": "string"
        },
        "resseq": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resseq"
        }
      },
      "required": [
        "resname",
        "category",
        "n_atoms"
      ],
      "title": "ComponentRecord",
      "type": "object"
    },
    "GapRecord": {
      "additionalProperties": false,
      "properties": {
        "after_residue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "After Residue"
        },
        "chain": {
          "minLength": 1,
          "title": "Chain",
          "type": "string"
        },
        "missing": {
          "items": {
            "type": "string"
          },
          "title": "Missing",
          "type": "array"
        },
        "modelled": {
          "title": "Modelled",
          "type": "boolean"
        },
        "position": {
          "enum": [
            "n_terminal",
            "internal",
            "c_terminal"
          ],
          "title": "Position",
          "type": "string"
        }
      },
      "required": [
        "chain",
        "missing",
        "position",
        "modelled"
      ],
      "title": "GapRecord",
      "type": "object"
    },
    "LicenseClass": {
      "description": "License class of an engine or dependency (ADR-0013).",
      "enum": [
        "open_source_permissive",
        "open_source_weak_copyleft",
        "open_source_copyleft",
        "academic_noncommercial",
        "commercial",
        "web_service",
        "unknown"
      ],
      "title": "LicenseClass",
      "type": "string"
    },
    "ResidueReplacement": {
      "additionalProperties": false,
      "properties": {
        "chain_id": {
          "minLength": 1,
          "title": "Chain Id",
          "type": "string"
        },
        "original_name": {
          "minLength": 1,
          "title": "Original Name",
          "type": "string"
        },
        "replacement_name": {
          "minLength": 1,
          "title": "Replacement Name",
          "type": "string"
        },
        "residue_id": {
          "minLength": 1,
          "title": "Residue Id",
          "type": "string"
        }
      },
      "required": [
        "chain_id",
        "residue_id",
        "original_name",
        "replacement_name"
      ],
      "title": "ResidueReplacement",
      "type": "object"
    },
    "SoftwareKind": {
      "description": "Role a piece of software plays in a provenance record.",
      "enum": [
        "engine",
        "adapter",
        "library",
        "platform",
        "service",
        "manual_step"
      ],
      "title": "SoftwareKind",
      "type": "string"
    },
    "SoftwareRef": {
      "additionalProperties": false,
      "description": "A piece of software that took part in producing a result (a provenance *agent*).",
      "properties": {
        "environment_id": {
          "anyOf": [
            {
              "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Environment Id"
        },
        "kind": {
          "$ref": "#/$defs/SoftwareKind"
        },
        "license_class": {
          "$ref": "#/$defs/LicenseClass",
          "default": "unknown"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "kind"
      ],
      "title": "SoftwareRef",
      "type": "object"
    },
    "StructureGeometryDiagnostics": {
      "additionalProperties": false,
      "description": "Configurable, conservative close-contact screen for a prepared structure.",
      "properties": {
        "close_contact_count": {
          "minimum": 0,
          "title": "Close Contact Count",
          "type": "integer"
        },
        "contacts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CloseHeavyAtomContact"
          },
          "title": "Contacts",
          "type": "array"
        },
        "contacts_truncated": {
          "default": false,
          "title": "Contacts Truncated",
          "type": "boolean"
        },
        "minimum_distance_A": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Distance A"
        },
        "threshold_A": {
          "exclusiveMinimum": 0,
          "title": "Threshold A",
          "type": "number"
        }
      },
      "required": [
        "threshold_A",
        "close_contact_count"
      ],
      "title": "StructureGeometryDiagnostics",
      "type": "object"
    }
  },
  "$id": "caddsuite://schemas/prepared_receptor/1.2",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "additionalProperties": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Artifacts",
      "type": "object"
    },
    "geometry_diagnostics": {
      "anyOf": [
        {
          "$ref": "#/$defs/StructureGeometryDiagnostics"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "id": {
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Id",
      "type": "string"
    },
    "kept": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ComponentRecord"
      },
      "title": "Kept",
      "type": "array"
    },
    "missing_heavy_atom_count": {
      "default": 0,
      "minimum": 0,
      "title": "Missing Heavy Atom Count",
      "type": "integer"
    },
    "missing_residues": {
      "default": [],
      "items": {
        "$ref": "#/$defs/GapRecord"
      },
      "title": "Missing Residues",
      "type": "array"
    },
    "modeling_seed": {
      "anyOf": [
        {
          "maximum": 2147483647,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Modeling Seed"
    },
    "nonstandard_replacements": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ResidueReplacement"
      },
      "title": "Nonstandard Replacements",
      "type": "array"
    },
    "output_atom_count": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Atom Count"
    },
    "output_residue_count": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Residue Count"
    },
    "ph": {
      "maximum": 14,
      "minimum": 0,
      "title": "Ph",
      "type": "number"
    },
    "protocol": {
      "$ref": "#/$defs/SoftwareRef"
    },
    "protonation_method": {
      "minLength": 1,
      "title": "Protonation Method",
      "type": "string"
    },
    "removed": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ComponentRecord"
      },
      "title": "Removed",
      "type": "array"
    },
    "schema_version": {
      "default": "prepared_receptor/1.2",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_chain_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Selected Chain Ids",
      "type": "array"
    },
    "structure_id": {
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Structure Id",
      "type": "string"
    },
    "supporting_software": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SoftwareRef"
      },
      "title": "Supporting Software",
      "type": "array"
    }
  },
  "required": [
    "id",
    "structure_id",
    "protocol",
    "ph",
    "protonation_method"
  ],
  "title": "PreparedReceptor",
  "type": "object"
}
