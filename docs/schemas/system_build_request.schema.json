{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Reference to a content-addressed artifact plus the role it plays for this result.",
      "properties": {
        "artifact_id": {
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "artifact_id",
        "role"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "JsonValue": {}
  },
  "$id": "caddsuite://schemas/system_build_request/1.0",
  "additionalProperties": false,
  "description": "Stable lineage and user choices supplied to a system-builder adapter.",
  "properties": {
    "complex_id": {
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Complex Id",
      "type": "string"
    },
    "compound_id": {
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Compound Id",
      "type": "string"
    },
    "form_id": {
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Form Id",
      "type": "string"
    },
    "id": {
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Id",
      "type": "string"
    },
    "mode": {
      "enum": [
        "import",
        "build"
      ],
      "title": "Mode",
      "type": "string"
    },
    "parameters": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Parameters",
      "type": "object"
    },
    "pose_id": {
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Pose Id",
      "type": "string"
    },
    "schema_version": {
      "default": "system_build_request/1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "selections": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Selections",
      "type": "object"
    },
    "source_artifacts": {
      "additionalProperties": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Source Artifacts",
      "type": "object"
    },
    "target_id": {
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Target Id",
      "type": "string"
    }
  },
  "required": [
    "id",
    "complex_id",
    "compound_id",
    "form_id",
    "target_id",
    "pose_id",
    "source_artifacts",
    "mode"
  ],
  "title": "SystemBuildRequest",
  "type": "object"
}
