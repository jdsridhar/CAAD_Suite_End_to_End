{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Reference to a content-addressed artifact plus the role it plays for this result.",
      "properties": {
        "artifact_id": {
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "artifact_id",
        "role"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ClusterMembership": {
      "additionalProperties": false,
      "properties": {
        "cluster_id": {
          "minimum": 1,
          "title": "Cluster Id",
          "type": "integer"
        },
        "cluster_size": {
          "minimum": 1,
          "title": "Cluster Size",
          "type": "integer"
        },
        "method": {
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "rmsd_cutoff_A": {
          "exclusiveMinimum": 0,
          "title": "Rmsd Cutoff A",
          "type": "number"
        }
      },
      "required": [
        "cluster_id",
        "cluster_size",
        "method",
        "rmsd_cutoff_A"
      ],
      "title": "ClusterMembership",
      "type": "object"
    },
    "DockingRun": {
      "additionalProperties": false,
      "properties": {
        "accession": {
          "pattern": "^CMP\\d{4,}_DOCK_\\d{3,}$",
          "title": "Accession",
          "type": "string"
        },
        "adapter": {
          "$ref": "#/$defs/SoftwareRef"
        },
        "conformer_id": {
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Conformer Id",
          "type": "string"
        },
        "engine": {
          "$ref": "#/$defs/SoftwareRef"
        },
        "form_id": {
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Form Id",
          "type": "string"
        },
        "id": {
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Id",
          "type": "string"
        },
        "params": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Params",
          "type": "object"
        },
        "pose_ids": {
          "default": [],
          "items": {
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
            "type": "string"
          },
          "title": "Pose Ids",
          "type": "array"
        },
        "receptor_id": {
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Receptor Id",
          "type": "string"
        },
        "schema_version": {
          "default": "docking_run/1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "site_id": {
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Site Id",
          "type": "string"
        },
        "stochastic": {
          "default": true,
          "title": "Stochastic",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "accession",
        "form_id",
        "conformer_id",
        "receptor_id",
        "site_id",
        "engine",
        "adapter",
        "params"
      ],
      "title": "DockingRun",
      "type": "object"
    },
    "DockingScore": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "docking_score",
          "default": "docking_score",
          "title": "Kind",
          "type": "string"
        },
        "ligand_efficiency": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ligand Efficiency"
        },
        "scoring_function": {
          "minLength": 1,
          "title": "Scoring Function",
          "type": "string"
        },
        "unit": {
          "const": "kcal/mol",
          "default": "kcal/mol",
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "scoring_function"
      ],
      "title": "DockingScore",
      "type": "object"
    },
    "JsonValue": {},
    "LicenseClass": {
      "description": "License class of an engine or dependency (ADR-0013).",
      "enum": [
        "open_source_permissive",
        "open_source_weak_copyleft",
        "open_source_copyleft",
        "academic_noncommercial",
        "commercial",
        "web_service",
        "unknown"
      ],
      "title": "LicenseClass",
      "type": "string"
    },
    "Pose": {
      "additionalProperties": false,
      "properties": {
        "accession": {
          "pattern": "^CMP\\d{4,}_POSE_\\d{3,}$",
          "title": "Accession",
          "type": "string"
        },
        "cluster": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClusterMembership"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fidelity_max_dev_A": {
          "minimum": 0,
          "title": "Fidelity Max Dev A",
          "type": "number"
        },
        "id": {
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Id",
          "type": "string"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "raw": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "rmsd_to_best_lb_A": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rmsd To Best Lb A"
        },
        "rmsd_to_best_ub_A": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rmsd To Best Ub A"
        },
        "run_id": {
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "default": "pose/1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "score": {
          "$ref": "#/$defs/DockingScore"
        },
        "structure": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "id",
        "accession",
        "run_id",
        "rank",
        "score",
        "structure",
        "raw",
        "fidelity_max_dev_A"
      ],
      "title": "Pose",
      "type": "object"
    },
    "SoftwareKind": {
      "description": "Role a piece of software plays in a provenance record.",
      "enum": [
        "engine",
        "adapter",
        "library",
        "platform",
        "service",
        "manual_step"
      ],
      "title": "SoftwareKind",
      "type": "string"
    },
    "SoftwareRef": {
      "additionalProperties": false,
      "description": "A piece of software that took part in producing a result (a provenance *agent*).",
      "properties": {
        "environment_id": {
          "anyOf": [
            {
              "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Environment Id"
        },
        "kind": {
          "$ref": "#/$defs/SoftwareKind"
        },
        "license_class": {
          "$ref": "#/$defs/LicenseClass",
          "default": "unknown"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "kind"
      ],
      "title": "SoftwareRef",
      "type": "object"
    }
  },
  "$id": "caddsuite://schemas/docking_result/1.0",
  "additionalProperties": false,
  "description": "A complete normalized docking-stage output with its ordered pose children.\n\nThe workflow scheduler transports one versioned contract per stage. This aggregate\nkeeps the DockingRun and pose contracts together without flattening pose data into\nuntyped JSON or losing the identity relationships needed by selection/MD stages.",
  "properties": {
    "artifacts": {
      "additionalProperties": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Artifacts",
      "type": "object"
    },
    "poses": {
      "items": {
        "$ref": "#/$defs/Pose"
      },
      "minItems": 1,
      "title": "Poses",
      "type": "array"
    },
    "run": {
      "$ref": "#/$defs/DockingRun"
    },
    "schema_version": {
      "default": "docking_result/1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "run",
    "poses"
  ],
  "title": "DockingResult",
  "type": "object"
}
