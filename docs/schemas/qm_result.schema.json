{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Reference to a content-addressed artifact plus the role it plays for this result.",
      "properties": {
        "artifact_id": {
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "artifact_id",
        "role"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ExcitedState": {
      "additionalProperties": false,
      "properties": {
        "energy_eV": {
          "exclusiveMinimum": 0,
          "title": "Energy Ev",
          "type": "number"
        },
        "index": {
          "minimum": 1,
          "title": "Index",
          "type": "integer"
        },
        "multiplicity": {
          "default": "singlet",
          "enum": [
            "singlet",
            "triplet"
          ],
          "title": "Multiplicity",
          "type": "string"
        },
        "oscillator_strength": {
          "minimum": 0,
          "title": "Oscillator Strength",
          "type": "number"
        },
        "wavelength_nm": {
          "exclusiveMinimum": 0,
          "title": "Wavelength Nm",
          "type": "number"
        }
      },
      "required": [
        "index",
        "energy_eV",
        "wavelength_nm",
        "oscillator_strength"
      ],
      "title": "ExcitedState",
      "type": "object"
    },
    "OrbitalEnergies": {
      "additionalProperties": false,
      "properties": {
        "gap_eV": {
          "title": "Gap Ev",
          "type": "number"
        },
        "homo_eV": {
          "title": "Homo Ev",
          "type": "number"
        },
        "lumo_eV": {
          "title": "Lumo Ev",
          "type": "number"
        }
      },
      "required": [
        "homo_eV",
        "lumo_eV",
        "gap_eV"
      ],
      "title": "OrbitalEnergies",
      "type": "object"
    },
    "PoseStrain": {
      "additionalProperties": false,
      "description": "Ligand strain of a docked pose. Only produced after the identity gate passes,\ni.e. the same InChIKey, formula and charge, with atoms mapped by substructure match\n(audit SCI-03).",
      "properties": {
        "atom_mapping": {
          "const": "substructure_match",
          "default": "substructure_match",
          "title": "Atom Mapping",
          "type": "string"
        },
        "docked_energy_Eh": {
          "title": "Docked Energy Eh",
          "type": "number"
        },
        "heavy_atom_rmsd_A": {
          "minimum": 0,
          "title": "Heavy Atom Rmsd A",
          "type": "number"
        },
        "hydrogen_treatment": {
          "minLength": 1,
          "title": "Hydrogen Treatment",
          "type": "string"
        },
        "identity_check_passed": {
          "const": true,
          "default": true,
          "title": "Identity Check Passed",
          "type": "boolean"
        },
        "pose_id": {
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Pose Id",
          "type": "string"
        },
        "reference_description": {
          "minLength": 1,
          "title": "Reference Description",
          "type": "string"
        },
        "reference_energy_Eh": {
          "title": "Reference Energy Eh",
          "type": "number"
        },
        "strain_kcal_per_mol": {
          "title": "Strain Kcal Per Mol",
          "type": "number"
        }
      },
      "required": [
        "pose_id",
        "docked_energy_Eh",
        "reference_energy_Eh",
        "strain_kcal_per_mol",
        "heavy_atom_rmsd_A",
        "hydrogen_treatment",
        "reference_description"
      ],
      "title": "PoseStrain",
      "type": "object"
    },
    "QMConvergence": {
      "additionalProperties": false,
      "properties": {
        "n_imaginary_frequencies": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N Imaginary Frequencies"
        },
        "optimization_converged": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Optimization Converged"
        },
        "scf_converged": {
          "title": "Scf Converged",
          "type": "boolean"
        }
      },
      "required": [
        "scf_converged"
      ],
      "title": "QMConvergence",
      "type": "object"
    }
  },
  "$id": "caddsuite://schemas/qm_result/1.0",
  "additionalProperties": false,
  "properties": {
    "calculation_id": {
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Calculation Id",
      "type": "string"
    },
    "charges": {
      "additionalProperties": {
        "items": {
          "type": "number"
        },
        "type": "array"
      },
      "title": "Charges",
      "type": "object"
    },
    "conceptual_dft": {
      "anyOf": [
        {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Conceptual Dft"
    },
    "convergence": {
      "$ref": "#/$defs/QMConvergence"
    },
    "dipole_D": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dipole D"
    },
    "excited_states": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ExcitedState"
      },
      "title": "Excited States",
      "type": "array"
    },
    "figures": {
      "additionalProperties": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Figures",
      "type": "object"
    },
    "missing": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Missing",
      "type": "array"
    },
    "orbitals": {
      "anyOf": [
        {
          "$ref": "#/$defs/OrbitalEnergies"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "pose_strain": {
      "anyOf": [
        {
          "$ref": "#/$defs/PoseStrain"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "default": "qm_result/1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "thermochemistry": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Thermochemistry",
      "type": "object"
    },
    "total_energy_Eh": {
      "title": "Total Energy Eh",
      "type": "number"
    },
    "vibrations_cm1": {
      "default": [],
      "items": {
        "type": "number"
      },
      "title": "Vibrations Cm1",
      "type": "array"
    },
    "volumetric": {
      "additionalProperties": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Volumetric",
      "type": "object"
    }
  },
  "required": [
    "calculation_id",
    "total_energy_Eh",
    "convergence"
  ],
  "title": "QMResult",
  "type": "object"
}
