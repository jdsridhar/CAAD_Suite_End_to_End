            "type": "string"
          },
          "title": "Processing",
          "type": "array"
        },
        "schema_version": {
          "default": "trajectory/1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "simulation_id": {
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Simulation Id",
          "type": "string"
        },
        "time_range_ns": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "minimum": 0,
              "type": "number"
            }
          ],
          "title": "Time Range Ns",
          "type": "array"
        },
        "topology": {
          "$ref": "#/$defs/ArtifactRef"
