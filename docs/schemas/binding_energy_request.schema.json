            "type": "object"
          },
          "title": "Engine Inputs",
          "type": "object"
        },
        "id": {
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Id",
          "type": "string"
        },
        "ionic_strength_M": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ionic Strength M"
        },
        "n_atoms": {
          "minimum": 1,
          "title": "N Atoms",
          "type": "integer"
        },
        "net_charge": {
          "title": "Net Charge",
          "type": "number"
        },
        "parameterization_id": {
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Parameterization Id",
          "type": "string"
        },
        "schema_version": {
          "default": "md_system/1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "selections": {
          "additionalProperties": {
            "$ref": "#/$defs/AtomSelection"
          },
          "title": "Selections",
          "type": "object"
        }
      },
      "required": [
        "id",
        "parameterization_id",
        "builder",
        "box",
        "n_atoms",
        "net_charge"
      ],
      "title": "MDSystem",
      "type": "object"
    },
    "Parameterization": {
      "additionalProperties": false,
      "description": "Which force field, ligand parameters, charges, water and ions: never implicit.",
      "properties": {
        "artifacts": {
          "additionalProperties": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Artifacts",
          "type": "object"
        },
        "compatibility_profile_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Compatibility Profile Id"
        },
        "component_force_fields": {
          "additionalProperties": {
            "$ref": "#/$defs/ComponentForceField"
          },
          "propertyNames": {
            "$ref": "#/$defs/ForceFieldComponent"
          },
          "title": "Component Force Fields",
          "type": "object"
        },
        "ff_family": {
          "$ref": "#/$defs/ForceFieldFamily"
        },
        "id": {
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Id",
          "type": "string"
        },
        "ion_parameters": {
          "minLength": 1,
          "title": "Ion Parameters",
          "type": "string"
        },
        "ligand_charge_model": {
          "minLength": 1,
          "title": "Ligand Charge Model",
          "type": "string"
        },
        "ligand_method": {
          "minLength": 1,
          "title": "Ligand Method",
          "type": "string"
        },
        "protein_ff": {
          "minLength": 1,
          "title": "Protein Ff",
          "type": "string"
        },
        "quality": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Quality",
          "type": "object"
        },
        "schema_version": {
          "default": "parameterization/1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "tool": {
          "$ref": "#/$defs/SoftwareRef"
        },
        "water_model": {
          "minLength": 1,
          "title": "Water Model",
          "type": "string"
        }
      },
      "required": [
        "id",
        "ff_family",
        "protein_ff",
        "ligand_method",
        "ligand_charge_model",
        "water_model",
        "ion_parameters",
        "tool"
      ],
      "title": "Parameterization",
      "type": "object"
    },
    "SegmentRecord": {
      "additionalProperties": false,
      "properties": {
        "artifacts": {
          "additionalProperties": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Artifacts",
          "type": "object"
        },
        "index": {
          "minimum": 1,
          "title": "Index",
          "type": "integer"
        },
        "length_ns": {
          "exclusiveMinimum": 0,
          "title": "Length Ns",
          "type": "number"
        },
        "n_steps": {
          "minimum": 1,
          "title": "N Steps",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/TaskState"
        }
      },
      "required": [
        "index",
        "length_ns",
        "n_steps",
        "status"
      ],
      "title": "SegmentRecord",
      "type": "object"
    },
    "SoftwareKind": {
      "description": "Role a piece of software plays in a provenance record.",
      "enum": [
        "engine",
        "adapter",
        "library",
        "platform",
        "service",
        "manual_step"
      ],
      "title": "SoftwareKind",
      "type": "string"
    },
    "SoftwareRef": {
      "additionalProperties": false,
      "description": "A piece of software that took part in producing a result (a provenance *agent*).",
      "properties": {
        "environment_id": {
          "anyOf": [
            {
              "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Environment Id"
        },
        "kind": {
          "$ref": "#/$defs/SoftwareKind"
        },
        "license_class": {
          "$ref": "#/$defs/LicenseClass",
          "default": "unknown"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "kind"
      ],
      "title": "SoftwareRef",
      "type": "object"
    },
    "TaskState": {
      "description": "Workflow task states (TARGET_ARCHITECTURE §8.2).",
      "enum": [
        "pending",
        "ready",
        "awaiting_decision",
        "running",
        "succeeded",
        "succeeded_with_warnings",
        "failed",
        "cancelled",
        "skipped",
        "cached",
        "interrupted"
      ],
      "title": "TaskState",
      "type": "string"
    },
    "Trajectory": {
