          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Id",
          "type": "string"
        },
        "n_frames": {
          "minimum": 1,
          "title": "N Frames",
          "type": "integer"
        },
        "processing": {
          "default": [],
