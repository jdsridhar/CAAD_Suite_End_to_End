{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Reference to a content-addressed artifact plus the role it plays for this result.",
      "properties": {
        "artifact_id": {
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "artifact_id",
        "role"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "AtomSelection": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "indices": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "n_atoms": {
          "minimum": 1,
          "title": "N Atoms",
          "type": "integer"
        },
        "verified": {
          "title": "Verified",
          "type": "boolean"
        }
      },
      "required": [
        "description",
        "n_atoms",
        "verified"
      ],
      "title": "AtomSelection",
      "type": "object"
    },
    "BindingEnergyMethod": {
      "enum": [
        "MM/GBSA",
        "MM/PBSA"
      ],
      "title": "BindingEnergyMethod",
      "type": "string"
    },
    "BoxSpec": {
      "additionalProperties": false,
      "properties": {
        "shape": {
          "enum": [
            "rectangular",
            "triclinic",
            "truncated_octahedron",
            "rhombic_dodecahedron"
          ],
          "title": "Shape",
          "type": "string"
        },
        "vectors_nm": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            }
          ],
          "title": "Vectors Nm",
          "type": "array"
        }
      },
      "required": [
        "shape",
        "vectors_nm"
      ],
      "title": "BoxSpec",
      "type": "object"
    },
    "ComponentForceField": {
      "additionalProperties": false,
      "description": "Force-field identity assigned to one physical system component.",
      "properties": {
        "family": {
          "$ref": "#/$defs/ForceFieldFamily"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "family",
        "name"
      ],
      "title": "ComponentForceField",
      "type": "object"
    },
    "EnergyUncertaintySettings": {
      "additionalProperties": false,
      "description": "Explicit block policy. Candidate diagnostics never choose a block size for users.",
      "properties": {
        "block_size_frames": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block Size Frames"
        },
        "minimum_blocks": {
          "default": 4,
          "minimum": 2,
          "title": "Minimum Blocks",
          "type": "integer"
        }
      },
      "title": "EnergyUncertaintySettings",
      "type": "object"
    },
    "EntropyTreatment": {
      "enum": [
        "none",
        "interaction_entropy",
        "c2",
        "nmode",
        "quasi_harmonic"
      ],
      "title": "EntropyTreatment",
      "type": "string"
    },
    "ForceFieldComponent": {
      "description": "Parameterized parts may use different families only under an explicit profile.",
      "enum": [
        "protein",
        "ligand",
        "water",
        "ions"
      ],
      "title": "ForceFieldComponent",
      "type": "string"
    },
    "ForceFieldFamily": {
      "enum": [
        "charmm",
        "amber",
        "openff"
      ],
      "title": "ForceFieldFamily",
      "type": "string"
    },
    "FrameSelection": {
      "additionalProperties": false,
      "properties": {
        "end_frame": {
          "minimum": 0,
          "title": "End Frame",
          "type": "integer"
        },
        "n_used": {
          "minimum": 1,
          "title": "N Used",
          "type": "integer"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "stride": {
          "default": 1,
          "minimum": 1,
          "title": "Stride",
          "type": "integer"
        },
        "window_ns": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "minimum": 0,
              "type": "number"
            }
          ],
          "title": "Window Ns",
          "type": "array"
        }
      },
      "required": [
        "start_frame",
        "end_frame",
        "n_used",
        "window_ns"
      ],
      "title": "FrameSelection",
      "type": "object"
    },
    "JsonValue": {},
    "LicenseClass": {
      "description": "License class of an engine or dependency (ADR-0013).",
      "enum": [
        "open_source_permissive",
        "open_source_weak_copyleft",
        "open_source_copyleft",
        "academic_noncommercial",
        "commercial",
        "web_service",
        "unknown"
      ],
      "title": "LicenseClass",
      "type": "string"
    },
    "MDProtocol": {
      "additionalProperties": false,
      "properties": {
        "stages": {
          "items": {
            "$ref": "#/$defs/MDStage"
          },
          "minItems": 1,
          "title": "Stages",
          "type": "array"
        }
      },
      "required": [
        "stages"
      ],
      "title": "MDProtocol",
      "type": "object"
    },
    "MDSimulation": {
      "additionalProperties": false,
      "properties": {
        "accession": {
          "pattern": "^CMP\\d{4,}_MD_\\d{3,}$",
          "title": "Accession",
          "type": "string"
        },
        "adapter": {
          "$ref": "#/$defs/SoftwareRef"
        },
        "engine": {
          "$ref": "#/$defs/SoftwareRef"
        },
        "id": {
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Id",
          "type": "string"
        },
        "performance_ns_per_day": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Performance Ns Per Day"
        },
        "protocol": {
          "$ref": "#/$defs/MDProtocol"
        },
        "schema_version": {
          "default": "md_simulation/1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "seeds": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Seeds",
          "type": "object"
        },
        "segments": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SegmentRecord"
          },
          "title": "Segments",
          "type": "array"
        },
        "system_id": {
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "System Id",
          "type": "string"
        },
        "total_ns": {
          "minimum": 0,
          "title": "Total Ns",
          "type": "number"
        }
      },
      "required": [
        "id",
        "accession",
        "system_id",
        "protocol",
        "engine",
        "adapter",
        "total_ns"
      ],
      "title": "MDSimulation",
      "type": "object"
    },
    "MDStage": {
      "additionalProperties": false,
      "properties": {
        "barostat": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Barostat"
        },
        "constraints": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Constraints"
        },
        "hmr": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hmr"
        },
        "integrator": {
          "minLength": 1,
          "title": "Integrator",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/MDStageKind"
        },
        "length_ns": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Length Ns"
        },
        "n_steps": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N Steps"
        },
        "nonbonded": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Nonbonded",
          "type": "object"
        },
        "pressure_bar": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pressure Bar"
        },
        "restraints": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Restraints"
        },
        "temperature_K": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature K"
        },
        "thermostat": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thermostat"
        },
        "timestep_fs": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 10,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timestep Fs"
        }
      },
      "required": [
        "kind",
        "integrator"
      ],
      "title": "MDStage",
      "type": "object"
    },
    "MDStageKind": {
      "enum": [
        "minimization",
        "nvt",
        "npt",
        "production"
      ],
      "title": "MDStageKind",
      "type": "string"
    },
    "MDSystem": {
      "additionalProperties": false,
      "properties": {
        "box": {
          "$ref": "#/$defs/BoxSpec"
        },
        "builder": {
          "$ref": "#/$defs/SoftwareRef"
        },
        "complex_id": {
          "anyOf": [
            {
              "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Complex Id"
        },
        "composition": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Composition",
          "type": "object"
        },
        "engine_inputs": {
          "additionalProperties": {
            "additionalProperties": {
              "$ref": "#/$defs/ArtifactRef"
