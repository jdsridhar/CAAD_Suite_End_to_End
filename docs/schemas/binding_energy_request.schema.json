  "$id": "caddsuite://schemas/binding_energy_request/1.1",
  "additionalProperties": false,
  "description": "Engine-neutral MM/PBSA request with linked MD system, protocol, and trajectory.",
  "properties": {
    "accession": {
      "pattern": "^CMP\\d{4,}_MMPBSA_\\d{3,}$",
      "title": "Accession",
      "type": "string"
    },
    "entropy": {
      "$ref": "#/$defs/EntropyTreatment",
      "default": "none"
    },
    "frames": {
      "$ref": "#/$defs/FrameSelection"
    },
    "id": {
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Id",
      "type": "string"
    },
    "method": {
      "$ref": "#/$defs/BindingEnergyMethod"
    },
    "model": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Model",
      "type": "object"
    },
    "parameterization": {
      "$ref": "#/$defs/Parameterization"
    },
    "salt_concentration_M": {
      "minimum": 0,
      "title": "Salt Concentration M",
      "type": "number"
    },
    "schema_version": {
      "default": "binding_energy_request/1.1",
      "title": "Schema Version",
      "type": "string"
    },
    "selection_groups": {
      "additionalProperties": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Selection Groups",
      "type": "object"
    },
    "simulation": {
      "$ref": "#/$defs/MDSimulation"
    },
    "source_artifacts": {
      "additionalProperties": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "minProperties": 2,
      "title": "Source Artifacts",
      "type": "object"
    },
    "system": {
      "$ref": "#/$defs/MDSystem"
    },
    "topology_format": {
      "minLength": 1,
      "title": "Topology Format",
      "type": "string"
    },
    "trajectory": {
      "$ref": "#/$defs/Trajectory"
    },
    "trajectory_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "trajectory_format": {
      "minLength": 1,
