{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Reference to a content-addressed artifact plus the role it plays for this result.",
      "properties": {
        "artifact_id": {
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "artifact_id",
        "role"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CubeRenderInput": {
      "additionalProperties": false,
      "description": "One hash-addressed cube artifact and the selected scalar field within it.",
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "dataset_index": {
          "default": 0,
          "minimum": 0,
          "title": "Dataset Index",
          "type": "integer"
        }
      },
      "required": [
        "artifact"
      ],
      "title": "CubeRenderInput",
      "type": "object"
    }
  },
  "$id": "caddsuite://schemas/frontier_orbital_render_request/1.0",
  "additionalProperties": false,
  "description": "Render signed HOMO/LUMO wavefunction isosurfaces on a shared molecular frame.",
  "properties": {
    "homo": {
      "$ref": "#/$defs/CubeRenderInput"
    },
    "homo_energy_eV": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Homo Energy Ev"
    },
    "id": {
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Id",
      "type": "string"
    },
    "isovalue_au": {
      "default": 0.02,
      "exclusiveMinimum": 0,
      "title": "Isovalue Au",
      "type": "number"
    },
    "lumo": {
      "$ref": "#/$defs/CubeRenderInput"
    },
    "lumo_energy_eV": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lumo Energy Ev"
    },
    "schema_version": {
      "default": "frontier_orbital_render_request/1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "show_molecular_skeleton": {
      "default": true,
      "title": "Show Molecular Skeleton",
      "type": "boolean"
    },
    "size_pixels": {
      "default": [
        1400,
        700
      ],
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "maximum": 6000,
          "minimum": 200,
          "type": "integer"
        },
        {
          "maximum": 6000,
          "minimum": 200,
          "type": "integer"
        }
      ],
      "title": "Size Pixels",
      "type": "array"
    }
  },
  "required": [
    "id",
    "homo",
    "lumo"
  ],
  "title": "FrontierOrbitalRenderRequest",
  "type": "object"
}
