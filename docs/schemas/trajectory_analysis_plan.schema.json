{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Reference to a content-addressed artifact plus the role it plays for this result.",
      "properties": {
        "artifact_id": {
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "artifact_id",
        "role"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "AtomSelection": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "indices": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "n_atoms": {
          "minimum": 1,
          "title": "N Atoms",
          "type": "integer"
        },
        "verified": {
          "title": "Verified",
          "type": "boolean"
        }
      },
      "required": [
        "description",
        "n_atoms",
        "verified"
      ],
      "title": "AtomSelection",
      "type": "object"
    },
    "TrajectoryMetric": {
      "description": "Coordinate metrics supported by an analysis adapter capability declaration.",
      "enum": [
        "backbone_rmsd",
        "ligand_pose_rmsd",
        "ligand_internal_rmsd",
        "protein_ca_rmsf",
        "protein_radius_of_gyration",
        "protein_ligand_min_distance",
        "protein_ligand_contact_count",
        "solvent_accessible_surface_area",
        "protein_ligand_hbond_count"
      ],
      "title": "TrajectoryMetric",
      "type": "string"
    }
  },
  "$id": "caddsuite://schemas/trajectory_analysis_plan/1.1",
  "additionalProperties": false,
  "properties": {
    "compound_id": {
      "anyOf": [
        {
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Compound Id"
    },
    "contact_cutoff_A": {
      "default": 6.0,
      "exclusiveMinimum": 0,
      "title": "Contact Cutoff A",
      "type": "number"
    },
    "end_time_ns": {
      "exclusiveMinimum": 0,
      "title": "End Time Ns",
      "type": "number"
    },
    "form_id": {
      "anyOf": [
        {
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Form Id"
    },
    "id": {
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Id",
      "type": "string"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/TrajectoryMetric"
      },
      "minItems": 1,
      "title": "Metrics",
      "type": "array"
    },
    "pose_fit_selection": {
      "anyOf": [
        {
          "$ref": "#/$defs/AtomSelection"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reference_frame": {
      "default": 0,
      "minimum": 0,
      "title": "Reference Frame",
      "type": "integer"
    },
    "rmsd_weighting": {
      "default": "uniform",
      "enum": [
        "uniform",
        "mass"
      ],
      "title": "Rmsd Weighting",
      "type": "string"
    },
    "schema_version": {
      "default": "trajectory_analysis_plan/1.1",
      "title": "Schema Version",
      "type": "string"
    },
    "selections": {
      "additionalProperties": {
        "$ref": "#/$defs/AtomSelection"
      },
      "minProperties": 1,
      "title": "Selections",
      "type": "object"
    },
    "simulation_id": {
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Simulation Id",
      "type": "string"
    },
    "start_time_ns": {
      "default": 0.0,
      "minimum": 0,
      "title": "Start Time Ns",
      "type": "number"
    },
    "stride": {
      "default": 1,
      "minimum": 1,
      "title": "Stride",
      "type": "integer"
    },
    "trajectory_id": {
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Trajectory Id",
      "type": "string"
    }
  },
  "required": [
    "id",
    "simulation_id",
    "trajectory_id",
    "selections",
    "metrics",
    "end_time_ns"
  ],
  "title": "TrajectoryAnalysisPlan",
  "type": "object"
}
