{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Reference to a content-addressed artifact plus the role it plays for this result.",
      "properties": {
        "artifact_id": {
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "artifact_id",
        "role"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "JsonValue": {},
    "LicenseClass": {
      "description": "License class of an engine or dependency (ADR-0013).",
      "enum": [
        "open_source_permissive",
        "open_source_weak_copyleft",
        "open_source_copyleft",
        "academic_noncommercial",
        "commercial",
        "web_service",
        "unknown"
      ],
      "title": "LicenseClass",
      "type": "string"
    },
    "MetricDefinition": {
      "additionalProperties": false,
      "description": "Exactly what was measured. For RMSD-type metrics the fit selection is mandatory:\nthe legacy \"ligand RMSD\" was fitted on the ligand itself, so it measured internal\nflexibility, not pose stability, and nothing in the output said so (audit SCI-06).",
      "properties": {
        "fit_selection": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fit Selection"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "refit": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Refit"
        },
        "target_selection": {
          "minLength": 1,
          "title": "Target Selection",
          "type": "string"
        },
        "weighting": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weighting"
        }
      },
      "required": [
        "target_selection"
      ],
      "title": "MetricDefinition",
      "type": "object"
    },
    "MetricSeries": {
      "additionalProperties": false,
      "properties": {
        "axis": {
          "enum": [
            "time_ns",
            "residue"
          ],
          "title": "Axis",
          "type": "string"
        },
        "definition": {
          "$ref": "#/$defs/MetricDefinition"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "series": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "summary": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Summary",
          "type": "object"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "value_column": {
          "minLength": 1,
          "title": "Value Column",
          "type": "string"
        },
        "window_ns": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "minimum": 0,
              "type": "number"
            }
          ],
          "title": "Window Ns",
          "type": "array"
        }
      },
      "required": [
        "name",
        "definition",
        "unit",
        "axis",
        "value_column",
        "series",
        "window_ns"
      ],
      "title": "MetricSeries",
      "type": "object"
    },
    "SoftwareKind": {
      "description": "Role a piece of software plays in a provenance record.",
      "enum": [
        "engine",
        "adapter",
        "library",
        "platform",
        "service",
        "manual_step"
      ],
      "title": "SoftwareKind",
      "type": "string"
    },
    "SoftwareRef": {
      "additionalProperties": false,
      "description": "A piece of software that took part in producing a result (a provenance *agent*).",
      "properties": {
        "environment_id": {
          "anyOf": [
            {
              "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Environment Id"
        },
        "kind": {
          "$ref": "#/$defs/SoftwareKind"
        },
        "license_class": {
          "$ref": "#/$defs/LicenseClass",
          "default": "unknown"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "kind"
      ],
      "title": "SoftwareRef",
      "type": "object"
    }
  },
  "$id": "caddsuite://schemas/trajectory_analysis_result/1.1",
  "additionalProperties": false,
  "description": "Normalized metric artifacts linked to their simulation and preprocessing result.",
  "properties": {
    "analyzer": {
      "$ref": "#/$defs/SoftwareRef"
    },
    "engine_artifacts": {
      "additionalProperties": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Engine Artifacts",
      "type": "object"
    },
    "id": {
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Id",
      "type": "string"
    },
    "log_artifacts": {
      "additionalProperties": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Log Artifacts",
      "type": "object"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/MetricSeries"
      },
      "title": "Metrics",
      "type": "array"
    },
    "parameters": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Parameters",
      "type": "object"
    },
    "preprocessing_result_id": {
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Preprocessing Result Id",
      "type": "string"
    },
    "raw_result": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "request_id": {
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "default": "trajectory_analysis_result/1.1",
      "title": "Schema Version",
      "type": "string"
    },
    "simulation_id": {
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Simulation Id",
      "type": "string"
    },
    "source_artifacts": {
      "additionalProperties": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "minProperties": 2,
      "title": "Source Artifacts",
      "type": "object"
    },
    "trajectory_id": {
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Trajectory Id",
      "type": "string"
    }
  },
  "required": [
    "id",
    "request_id",
    "simulation_id",
    "trajectory_id",
    "preprocessing_result_id",
    "analyzer",
    "parameters",
    "source_artifacts",
    "raw_result",
    "metrics"
  ],
  "title": "TrajectoryAnalysisResult",
  "type": "object"
}
