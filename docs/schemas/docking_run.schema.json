{
  "$defs": {
    "JsonValue": {},
    "LicenseClass": {
      "description": "License class of an engine or dependency (ADR-0013).",
      "enum": [
        "open_source_permissive",
        "open_source_weak_copyleft",
        "open_source_copyleft",
        "academic_noncommercial",
        "commercial",
        "web_service",
        "unknown"
      ],
      "title": "LicenseClass",
      "type": "string"
    },
    "SoftwareKind": {
      "description": "Role a piece of software plays in a provenance record.",
      "enum": [
        "engine",
        "adapter",
        "library",
        "platform",
        "service",
        "manual_step"
      ],
      "title": "SoftwareKind",
      "type": "string"
    },
    "SoftwareRef": {
      "additionalProperties": false,
      "description": "A piece of software that took part in producing a result (a provenance *agent*).",
      "properties": {
        "environment_id": {
          "anyOf": [
            {
              "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Environment Id"
        },
        "kind": {
          "$ref": "#/$defs/SoftwareKind"
        },
        "license_class": {
          "$ref": "#/$defs/LicenseClass",
          "default": "unknown"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "kind"
      ],
      "title": "SoftwareRef",
      "type": "object"
    }
  },
  "$id": "caddsuite://schemas/docking_run/1.0",
  "additionalProperties": false,
  "properties": {
    "accession": {
      "pattern": "^CMP\\d{4,}_DOCK_\\d{3,}$",
      "title": "Accession",
      "type": "string"
    },
    "adapter": {
      "$ref": "#/$defs/SoftwareRef"
    },
    "conformer_id": {
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Conformer Id",
      "type": "string"
    },
    "engine": {
      "$ref": "#/$defs/SoftwareRef"
    },
    "form_id": {
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Form Id",
      "type": "string"
    },
    "id": {
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Id",
      "type": "string"
    },
    "params": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Params",
      "type": "object"
    },
    "pose_ids": {
      "default": [],
      "items": {
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
        "type": "string"
      },
      "title": "Pose Ids",
      "type": "array"
    },
    "receptor_id": {
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Receptor Id",
      "type": "string"
    },
    "schema_version": {
      "default": "docking_run/1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seed"
    },
    "site_id": {
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Site Id",
      "type": "string"
    },
    "stochastic": {
      "default": true,
      "title": "Stochastic",
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "accession",
    "form_id",
    "conformer_id",
    "receptor_id",
    "site_id",
    "engine",
    "adapter",
    "params"
  ],
  "title": "DockingRun",
  "type": "object"
}
