        "title": "ValidationError",
        "type": "object"
      },
      "WorkflowDefinition": {
        "additionalProperties": false,
        "description": "A complete DAG declaration with no vendor-specific engine coupling.",
        "properties": {
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "inputs": {
            "additionalProperties": {
              "$ref": "#/components/schemas/WorkflowInput"
            },
            "title": "Inputs",
            "type": "object"
          },
          "name": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "outputs": {
            "additionalProperties": {
              "pattern": "^[a-z][a-z0-9_]{0,62}$",
              "type": "string"
            },
            "title": "Outputs",
            "type": "object"
          },
          "schema": {
            "const": "caddsuite.workflow/1",
            "title": "Schema",
            "type": "string"
          },
          "stages": {
            "items": {
              "$ref": "#/components/schemas/StageDefinition"
