          "name"
        ],
        "title": "CompoundCreateRequest",
        "type": "object"
      },
      "CompoundResponse": {
        "additionalProperties": false,
        "properties": {
          "compound": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "title": "Compound",
            "type": "object"
          },
          "created": {
            "title": "Created",
            "type": "boolean"
          },
          "input_record_id": {
            "title": "Input Record Id",
            "type": "string"
          }
        },
        "required": [
          "compound",
          "created",
          "input_record_id"
        ],
        "title": "CompoundResponse",
        "type": "object"
      },
      "DecisionScope": {
        "enum": [
          "task",
          "run",
          "project"
        ],
        "title": "DecisionScope",
        "type": "string"
      },
      "DecisionSubmitRequest": {
        "additionalProperties": false,
        "properties": {
          "chosen_key": {
            "pattern": "^[a-z0-9_]+$",
            "title": "Chosen Key",
            "type": "string"
          },
          "decided_by": {
            "minLength": 1,
            "title": "Decided By",
            "type": "string"
          },
          "expected_version": {
            "minimum": 0.0,
            "title": "Expected Version",
            "type": "integer"
          },
          "issue_id": {
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
            "title": "Issue Id",
            "type": "string"
          },
          "rationale": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rationale"
          },
          "scope": {
            "$ref": "#/components/schemas/DecisionScope",
            "default": "task"
          }
        },
        "required": [
          "issue_id",
          "chosen_key",
          "decided_by",
          "expected_version"
        ],
        "title": "DecisionSubmitRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "JsonValue": {},
      "ProjectCreateRequest": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          }
        },
        "required": [
          "slug",
          "name"
        ],
        "title": "ProjectCreateRequest",
        "type": "object"
      },
      "ProjectResponse": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          }
        },
        "required": [
          "id",
          "slug",
          "name"
        ],
        "title": "ProjectResponse",
        "type": "object"
      },
      "RetryPolicy": {
        "additionalProperties": false,
        "description": "Bounded retries for named retryable error codes; no retries are implicit.",
        "properties": {
          "backoff_multiplier": {
            "default": 2,
            "minimum": 1.0,
            "title": "Backoff Multiplier",
            "type": "number"
          },
          "initial_delay_s": {
            "default": 0,
            "minimum": 0.0,
            "title": "Initial Delay S",
            "type": "number"
          },
          "max_attempts": {
            "default": 1,
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Max Attempts",
            "type": "integer"
          },
          "max_delay_s": {
            "default": 300,
            "minimum": 0.0,
            "title": "Max Delay S",
            "type": "number"
          },
          "retry_on": {
            "default": [],
            "items": {
              "pattern": "^[A-Z][A-Z0-9_]*(\\.[A-Z][A-Z0-9_]*)+$",
              "type": "string"
            },
            "title": "Retry On",
            "type": "array"
          }
        },
        "title": "RetryPolicy",
        "type": "object"
      },
      "StageDefinition": {
        "additionalProperties": false,
        "description": "One declarative workflow node; plugin-specific parameters remain JSON data.",
        "properties": {
          "enabled": {
            "default": true,
            "title": "Enabled",
            "type": "boolean"
          },
          "engine": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Engine"
          },
          "for_each": {
            "anyOf": [
              {
                "enum": [
                  "compound",
                  "pose",
                  "selected_pose",
                  "target"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "For Each"
          },
          "gate": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gate"
          },
          "id": {
            "pattern": "^[a-z][a-z0-9_]{0,62}$",
            "title": "Id",
            "type": "string"
          },
          "input_bindings": {
            "additionalProperties": {
              "minLength": 1,
              "type": "string"
            },
            "title": "Input Bindings",
            "type": "object"
          },
          "input_contracts": {
            "additionalProperties": {
              "minLength": 1,
              "type": "string"
            },
            "title": "Input Contracts",
            "type": "object"
          },
          "kind": {
            "minLength": 1,
            "title": "Kind",
            "type": "string"
          },
          "needs": {
            "default": [],
            "items": {
              "pattern": "^[a-z][a-z0-9_]{0,62}$",
              "type": "string"
            },
            "title": "Needs",
            "type": "array"
          },
          "on_fail": {
            "default": "stop",
            "enum": [
              "exclude",
              "flag",
              "stop"
            ],
            "title": "On Fail",
            "type": "string"
          },
          "output_contract": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Contract"
          },
          "params": {
            "additionalProperties": true,
            "title": "Params",
            "type": "object"
          },
          "retry": {
            "$ref": "#/components/schemas/RetryPolicy"
          }
        },
        "required": [
          "id",
          "kind"
        ],
        "title": "StageDefinition",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
