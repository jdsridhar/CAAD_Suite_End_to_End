            "minItems": 1,
            "title": "Stages",
            "type": "array"
          }
        },
        "required": [
          "schema",
          "name",
          "stages"
        ],
        "title": "WorkflowDefinition",
        "type": "object"
      },
      "WorkflowInput": {
        "additionalProperties": false,
        "description": "A named value supplied to a run, with its normalized contract type.",
        "properties": {
          "contract": {
            "minLength": 1,
            "title": "Contract",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "required": {
            "default": true,
            "title": "Required",
            "type": "boolean"
          }
        },
        "required": [
          "contract"
        ],
        "title": "WorkflowInput",
        "type": "object"
      },
      "WorkflowRunSubmission": {
        "additionalProperties": false,
        "description": "Normalized workflow definition and contract JSON for a local API run.",
        "properties": {
          "inputs": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "title": "Inputs",
            "type": "object"
          },
          "workflow": {
            "$ref": "#/components/schemas/WorkflowDefinition"
          }
        },
        "required": [
          "workflow",
          "inputs"
        ],
        "title": "WorkflowRunSubmission",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
